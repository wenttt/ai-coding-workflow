# Jira
# ---
# JIRA_BASE_URL — your Jira root URL (no trailing slash).
#
# Two hosting modes:
#
# 1. Atlassian Cloud (default): JIRA_CLOUD=true (or unset).
#    JIRA_EMAIL = your Atlassian account email
#    JIRA_API_TOKEN = API token from id.atlassian.com/manage-profile/security/api-tokens
#    JIRA_BASE_URL example: https://your-company.atlassian.net
#
# 2. Self-hosted Server / Data Center: JIRA_CLOUD=false.
#    JIRA_EMAIL = unused (kept for diagnostic display)
#    JIRA_API_TOKEN = Personal Access Token (PAT) issued by your Jira admin
#                     or generated under your Jira profile -> Personal Access Tokens
#    JIRA_BASE_URL example: https://alm-jira.system.region.your-company.com
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_CLOUD=true

# GitHub
# ---
# GITHUB_TOKEN — Personal access token.
# - Public github.com / GitHub Enterprise Cloud: standard PAT
# - GitHub Enterprise Server (GHES): PAT issued on your GHES instance.
#   May require "Authorize for SAML SSO" if your org uses SSO.
#
# Required scopes (fine-grained or classic):
#   repo (read+write), workflow (push workflow files), issues (create/update)
#
# GITHUB_BASE_URL — leave UNSET for public github.com / Enterprise Cloud.
# For GHES, set to your instance's API endpoint:
#   https://<your-ghes-host>/api/v3
GITHUB_TOKEN=ghp_your_token_here
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo
# GITHUB_BASE_URL=https://alm-github.system.region.your-company.com/api/v3

# Workspace
# ---
# Absolute path to the local repo this server operates on.
# The server reads/writes files under this path.
WORKSPACE_PATH=/Users/you/code/your-repo

# Pipeline
# ---
# Path within WORKSPACE_PATH where operation logs are stored
OPERATION_LOG_DIR=docs/operations
DESIGN_DOC_DIR=docs/designs

# Retry / escalation
# ---
# Hard upper bound. Stage retries beyond this trigger escalation.
MAX_RETRIES_PER_STAGE=3

# Multi-project routing (optional)
# ---
# If you work on tickets across multiple Jira projects, each backed by a
# different GitHub repo, point this at a project_mapping.yaml file.
# See src/ai_coding_workflow/resources/project_mapping.example.yaml.
# When unset, all routing falls back to GITHUB_DEFAULT_OWNER/REPO + WORKSPACE_PATH.
# PROJECT_MAPPING_PATH=/path/to/project_mapping.yaml

# Logging
# ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
