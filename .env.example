# Jira
# ---
# Atlassian Cloud: use email + API token from id.atlassian.com/manage-profile/security/api-tokens
# Self-hosted: use username + personal access token
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# GitHub
# ---
# Personal access token with: repo, workflow scopes
# Or GitHub App installation token
GITHUB_TOKEN=ghp_your_token_here
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo

# Workspace
# ---
# Absolute path to the local repo this server operates on.
# The server reads/writes files under this path.
WORKSPACE_PATH=/Users/you/code/your-repo

# Pipeline
# ---
# Path within WORKSPACE_PATH where operation logs are stored
OPERATION_LOG_DIR=docs/operations
DESIGN_DOC_DIR=docs/designs

# Retry / escalation
# ---
# Hard upper bound. Stage retries beyond this trigger escalation.
MAX_RETRIES_PER_STAGE=3

# Logging
# ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
